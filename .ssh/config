Host prodesk
  HostName 192.168.1.130
  User murar8
  ForwardAgent yes
  IdentityAgent /run/user/1000/gcr/ssh

Host prodesk-unlock
  HostName 192.168.1.130
  Port 2222
  User root
  RequestTTY force

Host desktop
  HostName 192.168.1.60
  User murar8
  ForwardAgent yes

Host desktop-unlock
  HostName 192.168.1.60
  Port 2222
  User root
  RequestTTY force

Host thinkpad
  HostName 192.168.1.141
  User murar8
  ForwardAgent yes

Host winzoz
  HostName 192.168.1.160
  User murar8

Host koda
  HostName 10.77.0.20
  User agent
  ForwardAgent yes

Host home-server
  HostName 10.77.0.30
  User agent
  ForwardAgent yes

# The microVM taps are only reachable from desktop, so jump through it from
# anywhere else. No ProxyJump when already on desktop.
Match originalhost koda,home-server exec "test \"$(hostname)\" != desktop"
  ProxyJump desktop

