Host desktop
  HostName 192.168.1.60
  User murar8
  ForwardAgent yes

Host desktop-unlock
  HostName 192.168.1.60
  Port 2222
  User root
  RequestTTY force

Host prodesk
  HostName 192.168.1.130
  User murar8
  ForwardAgent yes
  IdentityAgent /run/user/1000/gcr/ssh

Host prodesk-unlock
  HostName 192.168.1.130
  Port 2222
  User root
  RequestTTY force

Host thinkpad
  HostName 192.168.1.141
  User murar8
  ForwardAgent yes

Host winzoz
  HostName 192.168.1.160
  User murar8

Host agent-vm
  HostName 10.77.0.2
  User agent
  ForwardAgent yes

# The microVM taps are only reachable from desktop, so jump through it from
# anywhere else. No ProxyJump when already on desktop.
Match originalhost agent-vm exec "test \"$(hostname)\" != desktop"
  ProxyJump desktop

