Host desktop
  HostName 192.168.1.60
  User murar8
  ForwardAgent yes

Host desktop-unlock
  HostName 192.168.1.60
  Port 2222
  User root
  RequestTTY force

Host prodesk
  HostName 192.168.1.130
  User murar8
  ForwardAgent yes
  IdentityAgent /run/user/1000/gcr/ssh

Host prodesk-unlock
  HostName 192.168.1.130
  Port 2222
  User root
  RequestTTY force

Host thinkpad
  HostName 192.168.1.141
  User murar8
  ForwardAgent yes

Host winzoz
  HostName 192.168.1.160
  User murar8

# Sandbox microVMs, one per roster entry in the flake's
# hosts/desktop/microvms/vm.nix. The address is 10.77.<cid>.2, so it changes
# only if that VM's cid does.
Host koda
  HostName 10.77.10.2
  SendEnv DOPPLER_TOKEN

Host home-server
  HostName 10.77.20.2

Host koda home-server
  User agent
  ForwardAgent yes
  # The guest's dotfiles autostart zellij for any ssh login, and this is always
  # one, so from a terminal already inside zellij the guest's would nest. This
  # is that autostart's own guard, passed through as a marker; the guest's sshd
  # AcceptEnvs exactly this.
  SendEnv ZELLIJ

# The microVM taps are only reachable from desktop, so jump through it from
# anywhere else. No ProxyJump when already on desktop.
Match originalhost koda,home-server exec "test \"$(hostname)\" != desktop"
  ProxyJump desktop

