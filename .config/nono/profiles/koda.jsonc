{
  "$schema": "../profile.schema.json",
  "extends": "default",
  "meta": {
    "name": "koda",
    "version": "0.4.0",
    "description": "Koda Health tree plus the JS toolchain caches its installs write to.",
    "author": "murar8"
  },
  "filesystem": {
    "allow": [
      "$HOME/Documents/Koda-Health",
      "$HOME/.cache/node",
      "$HOME/.cache/yarn",
      "$HOME/.yarn",
      "$HOME/.npm",
      "$HOME/.cache/node-gyp",
      "$HOME/.cache/uv"
    ]
  },
  "environment": {
    "set_vars": {
      "GH_CONFIG_DIR": "$TMPDIR/gh"
    }
  },
  "network": {
    "credentials": ["github"],
    "custom_credentials": {
      "github": {
        "upstream": "https://api.github.com",
        "credential_key": "github_koda",
        "env_var": "GH_TOKEN",
        "inject_header": "Authorization",
        "credential_format": "Bearer {}"
      }
    }
  }
}
