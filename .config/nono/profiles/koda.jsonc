{
  "$schema": "../profile.schema.json",
  "extends": "default",
  "meta": {
    "name": "koda",
    "version": "0.5.2",
    "description": "Koda Health tree plus the JS toolchain caches its installs write to.",
    "author": "murar8",
  },
  "filesystem": {
    "allow": [
      "$HOME/Documents/Koda-Health",
      "$HOME/.cache/node",
      "$HOME/.cache/yarn",
      "$HOME/.yarn",
      "$HOME/.npm",
      "$HOME/.cache/node-gyp",
      "$HOME/.cache/uv",
      // scripts/docs-build-staged.sh (pre-commit) builds the docs site into this
      // fixed path. Docusaurus scandirs its own out-dir, so the inherited
      // write-only grant on /tmp is not enough — it needs read+write here.
      "/tmp/docs-build-precommit",
    ],
  },
  "environment": {
    "set_vars": {
      // koda-backend/globalSetup.ts starts one mongod for the whole vitest run.
      // --nounixsocket: it otherwise binds /tmp/mongodb-<port>.sock, and covering
      // that needs write on /tmp, which Landlock only grants recursively.
      "KODA_TEST_MONGOD_ARGS": "--nounixsocket",
      "KODA_TEST_MONGOD_PORT": "47017",
    },
  },
  "network": {
    "allow_domain": ["cdn.sheetjs.com", "fastdl.mongodb.org"],
    "credentials": ["github"],
    "custom_credentials": {
      "github": {
        "upstream": "https://api.github.com",
        "credential_key": "github_koda",
        "env_var": "GH_TOKEN",
        "inject_header": "Authorization",
        "credential_format": "Bearer {}",
      },
    },
    // 47017: the vitest in-memory mongod the sandboxed test run spawns itself
    // (see KODA_TEST_MONGOD_PORT above) — the only port a sandboxed workload
    // binds. The local stack (SPAs, backend, mailpit, moto, mongo, mock EHR)
    // runs outside this session (docker on the host, or its own nono session),
    // so the agent needs neither bind nor connect on those ports. 9229
    // (backend --inspect) stays out too: connect on it drives the V8 inspector
    // = code exec in whatever host process binds it.
    "open_port": [47017],
  },
}
