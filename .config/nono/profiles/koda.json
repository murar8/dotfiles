{
  "$schema": "../profile.schema.json",
  "extends": "default",
  "meta": {
    "name": "koda",
    "version": "0.4.0",
    "description": "Koda Health tree plus the JS toolchain caches its installs write to.",
    "author": "murar8"
  },
  "filesystem": {
    "allow": [
      "$HOME/Documents/Koda-Health",
      "$HOME/.cache/node",
      "$HOME/.cache/yarn",
      "$HOME/.yarn",
      "$HOME/.npm",
      "$HOME/.cache/node-gyp",
      "$HOME/.cache/ms-playwright",
      "/dev/shm"
    ]
  },
  "environment": {
    "set_vars": {
      "GH_CONFIG_DIR": "$TMPDIR/gh"
    }
  },
  "network": {
    "open_port": [3000, 3001, 3050, 5173, 8025, 8080],
    "credentials": ["github"],
    "custom_credentials": {
      "github": {
        "upstream": "https://api.github.com",
        "credential_key": "github_koda_token",
        "env_var": "GH_TOKEN",
        "inject_header": "Authorization",
        "credential_format": "Bearer {}"
      }
    }
  }
}
