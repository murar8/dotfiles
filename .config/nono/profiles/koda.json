{
  "$schema": "../profile.schema.json",
  "meta": {
    "name": "koda",
    "version": "0.4.0",
    "description": "Koda Health work overlay. Composed onto a base profile via --extends; grants the Koda-Health tree and the JS toolchain caches its installs write to.",
    "author": "murar8"
  },
  "filesystem": {
    "allow": [
      "$HOME/Documents/Koda-Health",
      "$HOME/.cache/node",
      "$HOME/.cache/yarn",
      "$HOME/.yarn",
      "$HOME/.npm",
      "$HOME/.cache/node-gyp",
      "$HOME/.cache/ms-playwright",
      "/dev/shm",
      "/tmp/koda"
    ]
  },
  "environment": {
    "set_vars": {
      "TMPDIR": "/tmp/koda",
      "GH_CONFIG_DIR": "/tmp/koda/gh"
    }
  },
  "network": {
    "open_port": [3000, 3001, 3050, 5173, 8025, 8080],
    "credentials": ["github"],
    "custom_credentials": {
      "github": {
        "upstream": "https://api.github.com",
        "credential_key": "github_koda_token",
        "env_var": "GH_TOKEN",
        "inject_header": "Authorization",
        "credential_format": "Bearer {}"
      }
    }
  }
}
