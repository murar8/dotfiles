{
  "$schema": "../profile.schema.json",
  "extends": ["default", "commit"],
  "meta": {
    "name": "dotfiles",
    "version": "0.1.0",
    "description": "The ~/.dotfiles repo; worktree is $HOME, so tracked subtrees need read.",
    "author": "murar8",
  },
  "filesystem": {
    "allow": ["$HOME/.dotfiles"],
  },
}
