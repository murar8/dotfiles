{
  "$schema": "../profile.schema.json",
  "meta": {
    "name": "default",
    "version": "0.2.0",
    "description": "Host baseline every profile inherits: nix_runtime, read-only editor/dotfile configs, temp and device writes.",
    "author": "murar8"
  },
  "security": {
    "signal_mode": "isolated"
  },
  "groups": {
    "include": [
      "dangerous_commands",
      "dangerous_commands_linux",
      "deny_browser_data_linux",
      "deny_credentials",
      "deny_keychains_linux",
      "deny_shell_configs",
      "deny_shell_history",
      "nix_runtime",
      "system_read_linux_core",
      "system_write_linux",
      "user_tools"
    ]
  },
  "filesystem": {
    "allow": ["/tmp/nono-$UID"],
    "read": [
      "$HOME/.bootstrap",
      "$HOME/.dotfiles",
      "$HOME/.config/alacritty",
      "$HOME/.config/ghostty",
      "$HOME/.config/git",
      "$HOME/.config/helix",
      "$HOME/.config/lazygit",
      "$HOME/.config/looking-glass",
      "$HOME/.config/neovide",
      "$HOME/.config/nvim",
      "$HOME/.config/opencode",
      "$HOME/.config/zed",
      "$HOME/.config/zellij",
      "$HOME/.config/yarn",
      "$HOME/.config/nono"
    ],
    "read_file": [
      "$HOME/.bashrc",
      "$HOME/.completions.bash",
      "$HOME/.gitconfig",
      "$HOME/.gitignore",
      "$HOME/.ideavimrc",
      "$HOME/.inputrc",
      "$HOME/.shellcheckrc",
      "$HOME/.ssh/config",
      "$HOME/.tmux.conf",
      "$HOME/.yarnrc",
      "$HOME/.ssh/id_ed25519.pub",
      "$HOME/.config/git/allowed_signers",
      "/etc/passwd",
      "/etc/group"
    ],
    "unix_socket": ["/run/nscd/socket"],
    "suppress_save_prompt": [
      "/run/dbus/system_bus_socket",
      "$XDG_RUNTIME_DIR/bus"
    ],
    "bypass_protection": [
      "$HOME/.bashrc",
      "$HOME/.completions.bash",
      "$HOME/.ssh/config",
      "$HOME/.ssh/id_ed25519.pub"
    ]
  },
  "environment": {
    "set_vars": {
      "TMPDIR": "/tmp/nono-1000"
    }
  },
  "linux": {
    "af_unix_mediation": "pathname"
  },
  "network": {
    "network_profile": "developer",
    "tls_intercept": {
      "ca_env_vars": ["NODE_EXTRA_CA_CERTS"]
    }
  }
}
