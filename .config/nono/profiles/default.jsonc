{
  "$schema": "../profile.schema.json",
  "meta": {
    "name": "default",
    "version": "0.3.5",
    "description": "Host baseline every profile inherits: nix_runtime, read-only editor/dotfile configs, temp and device writes.",
    "author": "murar8",
  },
  "security": {
    "signal_mode": "isolated",
  },
  "rollback": {
    // Patterns with a slash match as a substring of the full path; without one
    // they must equal a whole path component.
    "exclude_patterns": [
      // Scratch, caches, toolchain state.
      "/tmp/",
      "/.cache/",
      "/.local/state/nix",
      "/.local/share/nix",
      "/.npm/",
      "/.yarn/",
      "/.cdk/",
      "/dev/shm",
      // Agent and dotfile trees: these carry their own history.
      "/.dotfiles",
      "/.claude",
      "/.local/state/claude",
      "/.pi",
      "/.opencode",
      "/.local/share/opencode",
      "/.local/share/opentui",
      "/.local/state/opencode",
      // Toolchain-managed trees the *-dev profiles reach for. Read-only today,
      // so these are pre-emptive: a profile that grants write must not turn a
      // package install into a rollback candidate.
      "/.nvm",
      "/.fnm",
      "/.node",
      "/.local/share/fnm",
      "/.local/share/pnpm",
      "/.bun",
      "/.cargo",
      "/.rustup",
      "/.pyenv",
      "/.conda",
      "/.local/share/uv",
      "/go/pkg",
      "/.sdkman",
      "/.m2/repository",
      "/.gradle",
      "/.local/share/mise",
      "/.vscode",
      "/.config/Code",
      // In-tree build and test artifacts. Bare generic names (`dist`, `build`,
      // `out`, `coverage`) stay out — they collide with real source dirs.
      ".direnv",
      ".turbo",
      ".vite",
      ".parcel-cache",
      ".venv",
      ".tox",
      ".pytest_cache",
      ".mypy_cache",
      ".ruff_cache",
      ".eslintcache",
      "cdk.out",
      ".terraform",
      ".esphome",
      "test-results",
      "playwright-report",
      // Git's own object store and index; reflog is the recovery path here.
      ".git",
    ],
    "exclude_globs": ["*.tsbuildinfo", "*.pyc", "*.log"],
  },
  "groups": {
    "include": [
      "dangerous_commands",
      "dangerous_commands_linux",
      "deny_browser_data_linux",
      "deny_credentials",
      "deny_keychains_linux",
      "deny_shell_configs",
      "deny_shell_history",
      "nix_runtime",
      "system_read_linux_core",
      "system_write_linux",
      "user_tools",
    ],
  },
  "filesystem": {
    // Literal uid: $UID expands in set_vars but not in filesystem rules.
    "allow": ["/tmp/nono-1000"],
    "read": [
      "$HOME/.bootstrap",
      "$HOME/.dotfiles",
      "$HOME/.config/alacritty",
      "$HOME/.config/ghostty",
      "$HOME/.config/git",
      "$HOME/.config/helix",
      "$HOME/.config/lazygit",
      "$HOME/.config/looking-glass",
      "$HOME/.config/neovide",
      "$HOME/.config/nvim",
      "$HOME/.config/opencode",
      "$HOME/.config/zed",
      "$HOME/.config/zellij",
      "$HOME/.config/yarn",
      "$HOME/.config/nono",
      // gh finds extensions only through its XDG data dir, which honours
      // neither GH_CONFIG_DIR nor the TMPDIR redirect below; without this
      // `gh <ext>` is not even a known command. Read-only on purpose — these
      // are executables the host's own gh runs, so a writable grant would be an
      // exec path out of the sandbox. Install extensions from the host.
      "$HOME/.local/share/gh",
    ],
    "read_file": [
      "$HOME/.bashrc",
      "$HOME/.completions.bash",
      "$HOME/.gitconfig",
      "$HOME/.gitignore",
      "$HOME/.ideavimrc",
      "$HOME/.inputrc",
      "$HOME/.shellcheckrc",
      "$HOME/.ssh/config",
      "$HOME/.tmux.conf",
      "$HOME/.yarnrc",
      "$HOME/.ssh/id_ed25519.pub",
      "$HOME/.config/git/allowed_signers",
      "/etc/passwd",
      "/etc/group",
    ],
    "unix_socket": ["/run/nscd/socket"],
    "suppress_save_prompt": [
      "/run/dbus/system_bus_socket",
      "$XDG_RUNTIME_DIR/bus",
    ],
    "bypass_protection": [
      "$HOME/.bashrc",
      "$HOME/.completions.bash",
      "$HOME/.ssh/config",
      "$HOME/.ssh/id_ed25519.pub",
    ],
  },
  "environment": {
    "set_vars": {
      "TMPDIR": "/tmp/nono-$UID",
      // ~/.config/gh holds the real host token and stays denied by
      // deny_credentials; gh cannot even start without somewhere to write its
      // state, so redirect it here. The token itself comes from GH_TOKEN, which
      // only the profiles defining a github credential route supply.
      "GH_CONFIG_DIR": "/tmp/nono-$UID/gh",
      // Both notifiers write timestamps to ~/.local/state/gh, which stays
      // ungranted; disabling them keeps that off the denial list.
      "GH_NO_UPDATE_NOTIFIER": "1",
      "GH_NO_EXTENSION_UPDATE_NOTIFIER": "1",
    },
  },
  "linux": {
    "af_unix_mediation": "pathname",
  },
  "network": {
    "network_profile": "developer",
    "tls_intercept": {
      "ca_env_vars": ["NODE_EXTRA_CA_CERTS"],
    },
  },
}
