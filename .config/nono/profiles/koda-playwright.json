{
  "$schema": "../profile.schema.json",
  "extends": "koda",
  "meta": {
    "name": "koda-playwright",
    "version": "0.1.0",
    "description": "Browser-driving sessions: Chromium's runtime sockets, plus a headed Wayland surface.",
    "author": "murar8"
  },
  "allow_gpu": true,
  "filesystem": {
    "allow": ["$HOME/.config/google-chrome-for-testing", "/dev/shm"],
    "unix_socket_subtree_bind": ["/tmp/nono-$UID"],
    "unix_socket": ["$XDG_RUNTIME_DIR/wayland-0"]
  },
  "environment": {
    "deny_vars": ["DISPLAY"],
    "set_vars": {
      "GSETTINGS_BACKEND": "memory"
    }
  },
  "network": {
    "open_port": [
      1025, 3000, 3001, 3002, 3050, 5173, 8025, 8080, 9000, 9001, 9229, 9500, 9510, 9520, 9530, 9540, 27017
    ]
  }
}
