{
  "$schema": "../profile.schema.json",
  "extends": "default",
  "meta": {
    "name": "nix",
    "version": "0.2.0",
    "description": "Nix daemon socket, client caches/state, and this host's substituters; /nix/store stays read-only.",
    "author": "murar8"
  },
  "groups": {
    "include": ["nix_runtime"]
  },
  "filesystem": {
    "allow": [
      "$HOME/.cache/nix",
      "$HOME/.cache/treefmt",
      "$HOME/.local/state/nix",
      "$HOME/.local/share/nix"
    ],
    "unix_socket": ["/nix/var/nix/daemon-socket/socket"]
  },
  "network": {
    "allow_domain": [
      "cache.nixos.org",
      "channels.nixos.org",
      "nixos.org",
      "nix-community.cachix.org",
      "cache.numtide.com",
      "microvm.cachix.org",
      "fenix.cachix.org"
    ]
  }
}
