{
  "$schema": "../profile.schema.json",
  "extends": "nolabs-ai/claude",
  "meta": {
    "name": "claude",
    "version": "0.5.0",
    "description": "Claude Code, with OAuth tokens captured as phantoms and the background daemon's control socket.",
    "author": "murar8",
  },
  "groups": {
    "exclude": ["vscode_linux"],
  },
  "filesystem": {
    // The bg daemon binds a unix socket here; /tmp is write-only from
    // system_write_linux, which is not enough to listen or connect.
    "allow": ["/tmp/cc-daemon-$UID"],
    // default sets af_unix_mediation: pathname, so bind/connect need their own
    // grant on top of the filesystem one. control.sock lives under a generated
    // <hash>/ dir and is recreated per daemon start, so this needs the subtree
    // form -- the exact-path grants resolve against a file that does not exist
    // yet. _subtree_bind covers both directions: daemon binds, clients connect.
    "unix_socket_subtree_bind": ["/tmp/cc-daemon-$UID"],
  },
  "environment": {
    "set_vars": {
      "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    },
  },
  "network": {
    "allow_domain": ["mcp-proxy.anthropic.com"],
  },
  "credential_providers": {
    "claude_code": {
      "type": "oauth_capture",
      "token_endpoints": [
        {
          "host": "https://platform.claude.com",
          "path": "/v1/oauth/token",
          "response_fields": [
            {
              "path": "access_token",
              "kind": "opaque",
            },
            {
              "path": "refresh_token",
              "kind": "opaque",
            },
          ],
          "request_body": "auto",
          "request_nonce_fields": ["refresh_token"],
        },
      ],
      "api_hosts": [
        "https://api.anthropic.com",
        "https://mcp-proxy.anthropic.com",
      ],
      "credential_store": {
        "type": "file_json",
        "path": "$HOME/.claude/.credentials.json",
        "phantom_fields": [
          "claudeAiOauth.accessToken",
          "claudeAiOauth.refreshToken",
        ],
      },
      "helpers": {
        "status": ["claude", "auth", "status", "--json"],
        "login": ["claude", "auth", "login"],
        "logout": ["claude", "auth", "logout"],
      },
    },
  },
  "credential_routes": [
    {
      "name": "claude_code_oauth",
      "provider": "claude_code",
    },
  ],
}
