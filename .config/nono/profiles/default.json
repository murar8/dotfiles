{
  "$schema": "../profile.schema.json",
  "meta": {
    "name": "default",
    "version": "0.1.0",
    "description": "Shadows the built-in default profile. Re-declares the built-in's security groups verbatim, then adds this host's read-only grants (nix store, editor configs, dotfiles, toolchain rc files, ssh signing pubkey). Every agent profile inherits this via its own extends chain.",
    "author": "murar8"
  },
  "security": {
    "signal_mode": "isolated"
  },
  "groups": {
    "include": [
      "deny_credentials",
      "deny_keychains_linux",
      "deny_browser_data_linux",
      "deny_shell_history",
      "deny_shell_configs",
      "system_read_linux_core",
      "system_write_linux",
      "user_tools",
      "dangerous_commands",
      "dangerous_commands_linux"
    ]
  },
  "filesystem": {
    "read": [
      "/nix/store",
      "$HOME/.bootstrap",
      "$HOME/.dotfiles",
      "$HOME/.config/alacritty",
      "$HOME/.config/ghostty",
      "$HOME/.config/git",
      "$HOME/.config/helix",
      "$HOME/.config/lazygit",
      "$HOME/.config/looking-glass",
      "$HOME/.config/neovide",
      "$HOME/.config/nvim",
      "$HOME/.config/opencode",
      "$HOME/.config/zed",
      "$HOME/.config/zellij",
      "$HOME/.config/yarn"
    ],
    "read_file": [
      "$HOME/.bashrc",
      "$HOME/.completions.bash",
      "$HOME/.gitconfig",
      "$HOME/.ideavimrc",
      "$HOME/.inputrc",
      "$HOME/.shellcheckrc",
      "$HOME/.ssh/config",
      "$HOME/.tmux.conf",
      "$HOME/.yarnrc",
      "$HOME/.ssh/id_ed25519.pub",
      "$HOME/.config/git/allowed_signers",
      "/etc/passwd",
      "/etc/group"
    ],
    "unix_socket": ["/run/nscd/socket"],
    "suppress_save_prompt": [
      "/run/dbus/system_bus_socket",
      "$XDG_RUNTIME_DIR/bus"
    ],
    "bypass_protection": [
      "$HOME/.bashrc",
      "$HOME/.completions.bash",
      "$HOME/.ssh/config",
      "$HOME/.ssh/id_ed25519.pub"
    ]
  },
  "linux": {
    "af_unix_mediation": "pathname"
  },
  "network": {
    "network_profile": "developer",
    "tls_intercept": {
      "ca_env_vars": ["NODE_EXTRA_CA_CERTS"]
    }
  }
}
