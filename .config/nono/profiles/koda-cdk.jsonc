{
  "$schema": "../profile.schema.json",
  "extends": ["koda", "doppler"],
  "meta": {
    "name": "koda-cdk",
    "version": "0.1.0",
    "description": "CDK synth/diff/deploy: proxy-signed AWS via koda-dev, plus the cdk cache.",
    "author": "murar8",
  },
  "filesystem": {
    "allow": ["$HOME/.cdk"],
  },
  "environment": {
    "deny_vars": ["AWS_PROFILE"],
    "set_vars": {
      "AWS_ACCESS_KEY_ID": "nono-brokered",
      "AWS_SECRET_ACCESS_KEY": "nono-brokered",
    },
  },
  "network": {
    "credentials": [
      "aws-sts",
      "aws-cloudformation",
      "aws-ssm",
      "aws-monitoring",
      "aws-sns",
      "aws-logs",
      "aws-secretsmanager",
      "aws-s3",
      "aws-s3-cdk-assets",
      "aws-ecr",
      "aws-elasticbeanstalk",
    ],
    // Docker layer push/pull authenticates with the ECR bearer token, not
    // SigV4, so the registry host is plain egress.
    "allow_domain": ["160009618678.dkr.ecr.us-east-1.amazonaws.com"],
    "custom_credentials": {
      "aws-sts": {
        "upstream": "https://sts.us-east-1.amazonaws.com",
        "aws_auth": {
          "profile": "koda-dev",
          "region": "us-east-1",
          "service": "sts",
        },
      },
      "aws-cloudformation": {
        "upstream": "https://cloudformation.us-east-1.amazonaws.com",
        "aws_auth": {
          "profile": "koda-dev",
          "region": "us-east-1",
          "service": "cloudformation",
        },
      },
      "aws-ssm": {
        "upstream": "https://ssm.us-east-1.amazonaws.com",
        "aws_auth": {
          "profile": "koda-dev",
          "region": "us-east-1",
          "service": "ssm",
        },
      },
      "aws-monitoring": {
        "upstream": "https://monitoring.us-east-1.amazonaws.com",
        "aws_auth": {
          "profile": "koda-dev",
          "region": "us-east-1",
          "service": "monitoring",
        },
      },
      "aws-sns": {
        "upstream": "https://sns.us-east-1.amazonaws.com",
        "aws_auth": {
          "profile": "koda-dev",
          "region": "us-east-1",
          "service": "sns",
        },
      },
      "aws-logs": {
        "upstream": "https://logs.us-east-1.amazonaws.com",
        "aws_auth": {
          "profile": "koda-dev",
          "region": "us-east-1",
          "service": "logs",
        },
      },
      "aws-secretsmanager": {
        "upstream": "https://secretsmanager.us-east-1.amazonaws.com",
        "aws_auth": {
          "profile": "koda-dev",
          "region": "us-east-1",
          "service": "secretsmanager",
        },
      },
      "aws-s3": {
        "upstream": "https://s3.us-east-1.amazonaws.com",
        "aws_auth": {
          "profile": "koda-dev",
          "region": "us-east-1",
          "service": "s3",
        },
        "endpoint_rules": [
          { "method": "GET", "path": "/**" },
          { "method": "HEAD", "path": "/**" },
        ],
      },
      "aws-ecr": {
        "upstream": "https://api.ecr.us-east-1.amazonaws.com",
        "aws_auth": {
          "profile": "koda-dev",
          "region": "us-east-1",
          "service": "ecr",
        },
      },
      "aws-elasticbeanstalk": {
        "upstream": "https://elasticbeanstalk.us-east-1.amazonaws.com",
        "aws_auth": {
          "profile": "koda-dev",
          "region": "us-east-1",
          "service": "elasticbeanstalk",
        },
      },
      "aws-s3-cdk-assets": {
        "upstream": "https://cdk-hnb659fds-assets-160009618678-us-east-1.s3.us-east-1.amazonaws.com",
        "aws_auth": {
          "profile": "koda-dev",
          "region": "us-east-1",
          "service": "s3",
        },
      },
    },
  },
}
